{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],

	"enabledManagers": [
		"kubernetes",
		"dockerfile"
	],

	"major": {
		"enabled": false
	},

	"packageRules": [
		{
			"groupName": "linuxserver",
			"matchPackageNames": [
				"lscr.io/linuxserver/{/,}**"
			]
		}
	]
}
