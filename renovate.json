{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],

	"kubernetes": {
		"managerFilePatterns": [
			"/(^|/)(downloads|infra|media|monitoring)/.*\\.ya?ml$/"
		]
	},

	"packageRules": [
		{
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"groupName": "linuxserver",
			"matchPackageNames": [
				"lscr.io/linuxserver/{/,}**"
			]
		}
	]
}
